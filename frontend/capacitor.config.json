{
  "appId": "com.velkiz.app",
  "appName": "Velkiz",
  "webDir": "dist",
  "backgroundColor": "#08060a",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#08060a",
    "scheme": "Velkiz"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#08060a",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound"
      ]
    }
  }
}
